#!name=lvn Locket Gold (45s Video, Nhãn dán, Full Ghi chú & Captions)
#!desc=Module Locket Gold tối ưu 2026: Kích hoạt Gold ổn định 100%, Quay video 45s, Dùng nhãn dán, Full Ghi chú & Caption, Không can thiệp API tránh lỗi SSL.
#!author=lvn

[Header Rewrite]
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) header-del X-RevenueCat-ETag
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-None-Match

[Script]
# 1. Xóa ETag để ép RevenueCat trả về body mã 200 đầy đủ
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), timeout=60, script-path=https://raw.githubusercontent.com/Imclownz/lvnnocket/master/locket60s/deleteHeader-expiry-check.js

# 2. Mở khóa gói bản quyền Gold vĩnh viễn (RevenueCat)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), requires-body=true, max-size=-1, timeout=60, script-path=https://raw.githubusercontent.com/Imclownz/lvnnocket/master/locket60s/lvn-presets-expiry-check.js

# 3. Kích hoạt Video 45s, Nhãn dán AI, Full Ghi chú & Captions (Firebase Remote Config)
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, requires-body=true, max-size=-1, timeout=60, script-path=https://raw.githubusercontent.com/Imclownz/lvnnocket/master/locket60s/lvn-presets-expiry-check.js

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
